# Managed by Ansible Elastic Integrated Demo.
server.name: elastic-demo
server.host: {{ elastic_demo.bind_address | to_json }}
server.port: 5601
server.publicBaseUrl: {{ elastic_demo.kibana_public_url | to_json }}
server.ssl.enabled: true
server.ssl.certificate: /etc/kibana/elastic-demo/node.crt
server.ssl.key: /etc/kibana/elastic-demo/node.key
elasticsearch.hosts: [{{ elastic_demo.elasticsearch_url | to_json }}]
elasticsearch.username: kibana_system
elasticsearch.password: {{ elastic_demo.kibana_system_password | to_json }}
elasticsearch.ssl.certificateAuthorities: [/etc/kibana/elastic-demo/ca.crt]
elasticsearch.ssl.verificationMode: full
xpack.security.encryptionKey: {{ elastic_demo.kibana_security_encryption_key | to_json }}
xpack.encryptedSavedObjects.encryptionKey: {{ elastic_demo.kibana_saved_objects_encryption_key | to_json }}
xpack.reporting.encryptionKey: {{ elastic_demo.kibana_reporting_encryption_key | to_json }}
xpack.security.secureCookies: true
telemetry.enabled: false
telemetry.optIn: false
